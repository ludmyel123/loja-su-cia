{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign size_option_index = null
  assign color_option_index = null
  for option in product.options_with_values
    assign name_down = option.name | downcase
    if name_down contains 'storlek' or name_down contains 'size' or name_down contains 'stl'
      assign size_option_index = option.position
    endif
    if name_down contains 'färg' or name_down contains 'farg' or name_down contains 'color' or name_down contains 'colour'
      assign color_option_index = option.position
    endif
  endfor
-%}

<div class="wrap" data-product-section="{{ section.id }}">
  <div class="breadcrumb">
    <a href="{{ routes.root_url }}">Hem</a> /
    {%- if product.collections.first -%}<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>{%- else -%}<span>Produkter</span>{%- endif -%} /
    <span>{{ product.title }}</span>
  </div>

  <product-page class="pdp" data-section-id="{{ section.id }}" data-product-handle="{{ product.handle }}">
    <div class="gallery">
      <div class="gallery-main">
        <button type="button" class="gallery-arrow prev" data-gallery-prev aria-label="Föregående bild">‹</button>
        <div class="ph" id="GalleryMain-{{ section.id }}">
          {%- for media in product.media -%}
            <img
              src="{{ media | image_url: width: 1000 }}"
              alt="{{ media.alt | default: product.title | escape }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              data-gallery-slide
              data-index="{{ forloop.index0 }}"
              style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0;{% unless forloop.first %}display:none;{% endunless %}">
          {%- else -%}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2.5 15.5c0-1.2.7-2 1.8-2.4L9 11l4.3-3.3c.9-.7 2-1 3.1-.7l3 .8c1 .3 1.8 1 2.1 2l.3 1c.3.9 1 1.6 1.9 1.8.9.2 1.3 1.3.7 2l-.6.7c-.5.6-1.3.9-2 .9H4.3c-1 0-1.8-.8-1.8-1.7Z"/><path d="M2.3 17.2h19.4"/></svg>
            <span class="tag">Ingen bild uppladdad</span>
          {%- endfor -%}
        </div>
        <button type="button" class="gallery-arrow next" data-gallery-next aria-label="Nästa bild">›</button>
      </div>
      {%- if product.media.size > 1 -%}
        <div class="thumb-row" id="ThumbRow-{{ section.id }}">
          {%- for media in product.media -%}
            <button type="button" class="thumb {% if forloop.first %}active{% endif %}" data-gallery-thumb data-index="{{ forloop.index0 }}">
              <img src="{{ media | image_url: width: 150 }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="pdp-info">
      {%- assign rating = product.metafields.reviews.rating.value -%}
      {%- assign rating_count = product.metafields.reviews.rating_count.value -%}
      {%- if rating != blank -%}
        <div class="rating">
          <span class="stars" aria-hidden="true">
            {%- assign full_stars = rating | round -%}
            {%- for i in (1..5) -%}{% if i <= full_stars %}★{% else %}☆{% endif %}{%- endfor -%}
          </span>
          {{ rating }}/5
          {%- if rating_count != blank %} {{ 'product.rating_based_on' | t: count: rating_count }}{% endif -%}
        </div>
      {%- endif -%}

      <h1>{{ product.title }}</h1>

      <div class="price-block" id="PriceBlock-{{ section.id }}">
        {%- if current_variant.compare_at_price > current_variant.price -%}
          {%- assign discount_amount = current_variant.compare_at_price | minus: current_variant.price -%}
          {%- assign discount_pct = discount_amount | times: 100.0 | divided_by: current_variant.compare_at_price | round -%}
          <span class="old" data-price-compare>{{ current_variant.compare_at_price | money }}</span>
          <span class="now" data-price>{{ current_variant.price | money }}</span>
          <span class="save-badge" data-price-save>{{ 'product.save_percent' | t: percent: discount_pct }}</span>
        {%- else -%}
          <span class="now" style="color:var(--ink);" data-price>{{ current_variant.price | money }}</span>
        {%- endif -%}
      </div>

      <div class="trust-list">
        {%- if settings.trust_shipping_text != blank -%}
          <div class="item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="1" y="7" width="15" height="10"/><path d="M16 10h4l3 3v4h-7"/><circle cx="6" cy="19" r="2"/><circle cx="18.5" cy="19" r="2"/></svg> {{ settings.trust_shipping_text }}</div>
        {%- endif -%}
        {%- if settings.trust_returns_text != blank -%}
          <div class="item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg> {{ settings.trust_returns_text }}</div>
        {%- endif -%}
        {%- if settings.trust_origin_text != blank -%}
          <div class="item"><span class="flag">🇸🇪</span> {{ settings.trust_origin_text }}</div>
        {%- endif -%}
      </div>

      {%- form 'product', product, id: 'ProductForm', class: 'product-form', data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" id="ProductVariantId-{{ section.id }}">

        {%- if color_option_index -%}
          {%- assign color_option = product.options_with_values[color_option_index | minus: 1] -%}
          <div class="field-label">{{ 'product.color_label' | t }} <span class="val" data-selected-color>{{ current_variant.options[color_option_index | minus: 1] }}</span></div>
          <div class="swatches" data-color-swatches data-option-index="{{ color_option_index | minus: 1 }}">
            {%- for value in color_option.values -%}
              {%- assign swatch_variant = current_variant -%}
              {%- for v in product.variants -%}
                {%- if v.options[color_option_index | minus: 1] == value -%}
                  {%- assign swatch_variant = v -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
              <button type="button" class="swatch {% if current_variant.options[color_option_index | minus: 1] == value %}active{% endif %}"
                data-option-value data-option-index="{{ color_option_index | minus: 1 }}" data-value="{{ value | escape }}" title="{{ value }}">
                <span class="ph" style="width:100%;height:100%;">
                  {%- if swatch_variant.featured_image -%}
                    <img src="{{ swatch_variant.featured_image | image_url: width: 100 }}" alt="{{ value }}" style="width:100%;height:100%;object-fit:cover;">
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2.5 15.5c0-1.2.7-2 1.8-2.4L9 11l4.3-3.3c.9-.7 2-1 3.1-.7l3 .8c1 .3 1.8 1 2.1 2l.3 1c.3.9 1 1.6 1.9 1.8.9.2 1.3 1.3.7 2l-.6.7c-.5.6-1.3.9-2 .9H4.3c-1 0-1.8-.8-1.8-1.7Z"/></svg>
                  {%- endif -%}
                </span>
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if size_option_index -%}
          {%- assign size_option = product.options_with_values[size_option_index | minus: 1] -%}
          <div class="size-block" data-option-index="{{ size_option_index | minus: 1 }}">
            <div class="field-label" style="justify-content:space-between;">
              <span>{{ 'product.size_label' | t }} <span class="val" data-selected-size>{{ 'product.choose_size' | t }}</span></span>
              {%- if section.settings.size_guide_url != blank -%}
                <a href="{{ section.settings.size_guide_url }}" class="size-guide-link">{{ 'product.size_guide' | t }}</a>
              {%- endif -%}
            </div>
            <div class="size-grid" data-size-grid>
              {%- for value in size_option.values -%}
                {%- assign size_available = false -%}
                {%- for v in product.variants -%}
                  {%- if v.options[size_option_index | minus: 1] == value and v.available -%}
                    {%- assign size_available = true -%}
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
                <button type="button" class="size-chip {% unless size_available %}disabled{% endunless %}"
                  data-option-value data-option-index="{{ size_option_index | minus: 1 }}" data-value="{{ value | escape }}"
                  {% unless size_available %}disabled aria-disabled="true"{% endunless %}
                  title="{% if size_available %}{{ value }}{% else %}Slut i lager{% endif %}">{{ value }}</button>
              {%- endfor -%}
            </div>
            <div class="size-warning" data-size-warning hidden>⚠ {{ 'product.choose_size_warning' | t }}</div>
          </div>
        {%- endif -%}

        {%- comment -%} Övriga optioner (t.ex. bredd) renderas som enkla knappar {%- endcomment -%}
        {%- for option in product.options_with_values -%}
          {%- unless option.position == size_option_index or option.position == color_option_index -%}
            <div class="field-label">{{ option.name }} <span class="val" data-selected-option="{{ option.position | minus: 1 }}">{{ current_variant.options[option.position | minus: 1] }}</span></div>
            <div class="swatches">
              {%- for value in option.values -%}
                <button type="button" class="size-chip {% if current_variant.options[option.position | minus: 1] == value %}active{% endif %}"
                  data-option-value data-option-index="{{ option.position | minus: 1 }}" data-value="{{ value | escape }}">{{ value }}</button>
              {%- endfor -%}
            </div>
          {%- endunless -%}
        {%- endfor -%}

        <div class="stock-line" id="StockLine-{{ section.id }}" {% if current_variant.inventory_management == blank or current_variant.inventory_quantity > 10 or current_variant.inventory_quantity < 1 %}hidden{% endif %}>
          <span class="stock-dot"></span> {{ 'product.only_left_in_stock' | t: count: current_variant.inventory_quantity }}
        </div>

        <div class="qty-row">
          <div class="qty-stepper lg" data-quantity-stepper>
            <button type="button" data-quantity-minus aria-label="Minska antal">−</button>
            <input type="number" name="quantity" value="1" min="1" id="Quantity-{{ section.id }}" data-quantity-input aria-label="{{ 'product.quantity' | t }}">
            <button type="button" data-quantity-plus aria-label="Öka antal">+</button>
          </div>
          <button type="submit" class="btn success block add-btn" id="AddToCart-{{ section.id }}" data-add-to-cart {% unless current_variant.available %}disabled{% endunless %}>
            <span class="lbl-default">
              {%- if current_variant.available -%}{{ 'product.add_to_cart' | t }}{%- else -%}{{ 'product.sold_out' | t }}{%- endif -%}
            </span>
            <span class="spinner"></span>
            <span class="lbl-done">✓ {{ 'product.added_to_cart' | t }}</span>
          </button>
        </div>
      {%- endform -%}

      {%- if settings.free_shipping_threshold > 0 -%}
        <div class="ship-row">
          <span><span class="dot"></span>{{ 'product.free_shipping' | t }}</span>
          <span>🇸🇪 {{ settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros }}+</span>
        </div>
      {%- endif -%}

      {%- if settings.show_payment_badges -%}{% render 'payment-badges' %}{%- endif -%}

      {%- if section.settings.show_urgency_box -%}
        <div class="urgency-box" style="margin-top:1.2rem;">
          <div class="h">% {{ section.settings.urgency_heading }}</div>
          <p>{{ section.settings.urgency_text }}</p>
          {%- if section.settings.urgency_combo_1 != blank or section.settings.urgency_combo_2 != blank -%}
            <hr>
            {%- if section.settings.urgency_combo_1 != blank -%}<div class="combo">{{ section.settings.urgency_combo_1 }}</div>{%- endif -%}
            {%- if section.settings.urgency_combo_2 != blank -%}<div class="combo">{{ section.settings.urgency_combo_2 }}</div>{%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="accordion">
        <div class="acc-item open">
          <button type="button" class="acc-trigger" data-acc-trigger>{{ 'product.description' | t }} <span class="plus">+</span></button>
          <div class="acc-panel" style="max-height:2000px;"><div class="acc-panel-inner">{{ product.description }}</div></div>
        </div>
        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' -%}
            <div class="acc-item" {{ block.shopify_attributes }}>
              <button type="button" class="acc-trigger" data-acc-trigger>{{ block.settings.title }} <span class="plus">+</span></button>
              <div class="acc-panel"><div class="acc-panel-inner">{{ block.settings.content }}</div></div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.social_proof_text != blank -%}
        <div class="social-proof">
          <span>{{ section.settings.social_proof_text }}</span>
        </div>
      {%- endif -%}

      <div class="sticky-bar">
        <div style="width:44px;height:52px;border-radius:3px;overflow:hidden;" class="ph">
          {%- if product.featured_media -%}
            <img src="{{ product.featured_media | image_url: width: 100 }}" alt="" style="width:100%;height:100%;object-fit:cover;">
          {%- endif -%}
        </div>
        <div class="info"><div class="n">{{ product.title }}</div><div class="p" data-price-sticky>{{ current_variant.price | money }}</div></div>
        <button type="button" class="btn success" data-add-to-cart-sticky {% unless current_variant.available %}disabled{% endunless %}>{{ 'product.buy_now' | t }}</button>
      </div>
    </div>
  </product-page>

  <script type="application/json" id="ProductJson-{{ section.id }}">
    {{ product | json }}
  </script>
</div>

{% schema %}
{
  "name": "Produktsida",
  "settings": [
    { "type": "url", "id": "size_guide_url", "label": "Länk till storleksguide" },
    { "type": "header", "content": "Kampanjruta" },
    { "type": "checkbox", "id": "show_urgency_box", "label": "Visa kampanjruta", "default": true },
    { "type": "text", "id": "urgency_heading", "label": "Rubrik", "default": "HÖSTREA UPP TILL −80%" },
    { "type": "textarea", "id": "urgency_text", "label": "Text", "default": "Efterfrågan har varit stor och lagret krymper. Så länge \"Lägg i varukorg\" är aktiv kan du fortfarande handla." },
    { "type": "text", "id": "urgency_combo_1", "label": "Kombinationsrad 1", "default": "🛍️ Lägg till 2 par → 10% extra rabatt" },
    { "type": "text", "id": "urgency_combo_2", "label": "Kombinationsrad 2", "default": "Lägg till 3 par → 15% extra rabatt" },
    { "type": "header", "content": "Socialt bevis" },
    { "type": "text", "id": "social_proof_text", "label": "Text (lämna tomt för att dölja)", "info": "Fyll bara i detta med riktiga siffror/namn — lämna tomt tills ni har riktig data." }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Utfällbart avsnitt",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Frakt" },
        { "type": "richtext", "id": "content", "label": "Innehåll" }
      ]
    }
  ]
}
{% endschema %}
