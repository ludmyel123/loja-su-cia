<section class="hero" style="min-height:{{ section.settings.height }}px;">
  <div class="ph tone-1 ph-bg" style="position:absolute;inset:0;border-radius:0;">
    {%- if section.settings.image -%}
      <img src="{{ section.settings.image | image_url: width: 1800 }}" alt="" loading="eager" fetchpriority="high" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0;">
    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M4 20V10l8-6 8 6v10"/><path d="M9 20v-6h6v6"/></svg>
      <span class="tag">Bild saknas — ladda upp i sektionens inställningar</span>
    {%- endif -%}
  </div>
  <div class="wrap hero-inner">
    {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="btn light">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero-banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bakgrundsbild" },
    { "type": "range", "id": "height", "label": "Höjd (px)", "min": 320, "max": 720, "step": 20, "default": 560 },
    { "type": "text", "id": "eyebrow", "label": "Liten text ovanför", "default": "Begränsat lager" },
    { "type": "text", "id": "heading", "label": "Rubrik", "default": "Höstrea" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Upptäck vår höstkollektion av skor — upp till 50% rabatt." },
    { "type": "text", "id": "button_label", "label": "Knapptext", "default": "Läs mer" },
    { "type": "url", "id": "button_link", "label": "Knapplänk" }
  ],
  "presets": [
    { "name": "Hero-banner" }
  ]
}
{% endschema %}
