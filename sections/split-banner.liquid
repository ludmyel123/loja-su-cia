<section class="split-banner">
  {%- for block in section.blocks -%}
    <a href="{{ block.settings.link | default: '#' }}" class="panel" {{ block.shopify_attributes }}>
      <div class="ph tone-{{ forloop.index | plus: 2 }}" style="position:absolute;inset:0;border-radius:0;">
        {%- if block.settings.image -%}
          <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0;">
        {%- endif -%}
      </div>
      <div class="content">
        <h3 class="serif">{{ block.settings.heading }}</h3>
        <p>{{ block.settings.text }}</p>
        <span class="btn outline">{{ block.settings.button_label }}</span>
      </div>
    </a>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Delad banner",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "text", "id": "heading", "label": "Rubrik", "default": "Dam" },
        { "type": "text", "id": "text", "label": "Text", "default": "Utforska vår damkollektion av skor." },
        { "type": "text", "id": "button_label", "label": "Knapptext", "default": "Se mer" },
        { "type": "url", "id": "link", "label": "Länk" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Delad banner",
      "blocks": [
        { "type": "panel", "settings": { "heading": "Dam", "text": "Utforska vår damkollektion av skor." } },
        { "type": "panel", "settings": { "heading": "Herr", "text": "Utforska vår herrkollektion av skor." } }
      ]
    }
  ]
}
{% endschema %}
