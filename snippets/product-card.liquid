{%- comment -%}
  Renders one product card for a grid. Usage: {% render 'product-card', product: product %}
{%- endcomment -%}

{%- assign on_sale = false -%}
{%- if product.compare_at_price > product.price -%}
  {%- assign on_sale = true -%}
  {%- assign discount_amount = product.compare_at_price | minus: product.price -%}
  {%- assign discount_pct = discount_amount | times: 100.0 | divided_by: product.compare_at_price | round -%}
{%- endif -%}

<a href="{{ product.url }}" class="p-card" style="position:relative;">
  <div class="ph tone-{{ product.id | modulo: 4 | plus: 1 }}" style="aspect-ratio:3/4;border-radius:4px;">
    {%- if product.featured_image -%}
      <img
        src="{{ product.featured_image | image_url: width: 600 }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        loading="lazy"
        width="600" height="800"
        style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0;">
    {%- else -%}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M2.5 15.5c0-1.2.7-2 1.8-2.4L9 11l4.3-3.3c.9-.7 2-1 3.1-.7l3 .8c1 .3 1.8 1 2.1 2l.3 1c.3.9 1 1.6 1.9 1.8.9.2 1.3 1.3.7 2l-.6.7c-.5.6-1.3.9-2 .9H4.3c-1 0-1.8-.8-1.8-1.7Z"/><path d="M2.3 17.2h19.4"/></svg>
      <span class="tag">Bild saknas</span>
    {%- endif -%}
    {%- unless product.available -%}
      <span class="badge" style="background:var(--ink-faint);">{{ 'product.sold_out' | t }}</span>
    {%- else -%}
      {%- if on_sale -%}<span class="badge">−{{ discount_pct }}%</span>{%- endif -%}
    {%- endunless -%}
  </div>
  <div class="name">{{ product.title }}</div>
  <div class="price">
    {%- if on_sale -%}
      <span class="old">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
      <span class="now">{{ product.price | money_without_trailing_zeros }}</span>
    {%- else -%}
      <span class="now" style="color:var(--ink);">{{ product.price | money_without_trailing_zeros }}</span>
    {%- endif -%}
  </div>
</a>
